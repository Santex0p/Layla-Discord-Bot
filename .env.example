# DISCORD APP
APP_ID=<YOUR_DISCORD_APP_ID>
DISCORD_TOKEN=<YOUR_DISCORD_APP_TOKEN>
DISCORD_CLIENT_SECRET=<YOUR_DISCORD_CLIENT_SECRET>
PUBLIC_KEY=<YOUR_DISCORD_APP_PUBLIC_KEY>

# DASHBOARD ADMIN
SUPERADMIN_ID=<YOUR_DISCORD_USER_ID>

# API KEY OF GEMINI
